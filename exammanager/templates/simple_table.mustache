{{!
    @template local_exammanager/simple_table

    A generaltable rendered from plain header/row data, with a fallback
    "empty" message when there are no rows. Used as a partial by the
    reports and history pages.

    Classes required for JS: none.
    Data attributes required for JS: none.

    Context variables required for this template:
    * hasrows boolean Whether there is at least one row.
    * headers array List of column header strings.
    * rows array List of {cells: array of strings}.
    * emptymessage string Message shown when hasrows is false.

    Example context (json):
    {
        "hasrows": true,
        "headers": ["Room", "Open", "Close", "Total"],
        "rows": [{"cells": ["B12", "2026-06-15 09:00", "2026-06-15 11:00", "2"]}],
        "emptymessage": "No room conflict"
    }
}}
{{#hasrows}}
<table class="generaltable">
    <thead>
        <tr>
            {{#headers}}<th>{{.}}</th>{{/headers}}
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            {{#cells}}<td>{{.}}</td>{{/cells}}
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}
<div class="local-exammanager-muted">{{emptymessage}}</div>
{{/hasrows}}
