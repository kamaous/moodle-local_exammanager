{{!
    @template local_exammanager/reports

    Side-by-side room and supervisor scheduling conflict panels.

    Classes required for JS: none.
    Data attributes required for JS: none.

    Context variables required for this template:
    * roomstitle string Room conflicts panel title.
    * teacherstitle string Supervisor conflicts panel title.
    * rooms object simple_table context for the room conflicts table.
    * teachers object simple_table context for the supervisor conflicts table.

    Example context (json):
    {
        "roomstitle": "Room conflicts",
        "teacherstitle": "Supervisor conflicts",
        "rooms": {"hasrows": false, "headers": [], "rows": [], "emptymessage": "No room conflict"},
        "teachers": {"hasrows": false, "headers": [], "rows": [], "emptymessage": "No supervisor conflict"}
    }
}}
<div class="local-exammanager-grid">
    <div class="local-exammanager-panel">
        <h3 class="local-exammanager-sectiontitle">{{roomstitle}}</h3>
        {{#rooms}}{{> local_exammanager/simple_table}}{{/rooms}}
    </div>
    <div class="local-exammanager-panel">
        <h3 class="local-exammanager-sectiontitle">{{teacherstitle}}</h3>
        {{#teachers}}{{> local_exammanager/simple_table}}{{/teachers}}
    </div>
</div>
