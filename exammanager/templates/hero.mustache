{{!
    @template local_exammanager/hero

    Page header banner with a title, a subtitle and optional action links.
    Used at the top of every plugin page.

    Classes required for JS: none.
    Data attributes required for JS: none.

    Context variables required for this template:
    * title string Page title.
    * subtitle string Page subtitle.
    * hasactions boolean Whether the action links row should be shown.
    * actions array List of {url, label} action links.

    Example context (json):
    {
        "title": "Dashboard",
        "subtitle": "Overview",
        "hasactions": true,
        "actions": [{"url": "#", "label": "Program exams"}]
    }
}}
<div class="local-exammanager-hero">
    <h2>{{title}}</h2>
    <div class="local-exammanager-muted">{{subtitle}}</div>
    {{#hasactions}}
    <div class="local-exammanager-actions">
        {{#actions}}
        <a href="{{url}}">{{label}}</a>
        {{/actions}}
    </div>
    {{/hasactions}}
</div>
